# EventEase Application - Environment Configuration Template
# Copy this file to .env and update with your actual values

# =====================================
# DATABASE CONFIGURATION
# =====================================
DB_HOST=localhost
DB_PORT=1433
DB_NAME=EventEaseDb
DB_USER=sa
DB_PASSWORD=EventEase2025!
DB_TRUST_SERVER_CERTIFICATE=True

# Connection String (Auto-generated from above)
ConnectionStrings__DefaultConnection=Server=${DB_HOST},${DB_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=${DB_TRUST_SERVER_CERTIFICATE};

# =====================================
# REDIS CONFIGURATION
# =====================================
REDIS_HOST=localhost
REDIS_PORT=6379
ConnectionStrings__RedisConnection=${REDIS_HOST}:${REDIS_PORT}

# =====================================
# APPLICATION SETTINGS
# =====================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5040
APP_BASE_URL=http://localhost:5040
API_BASE_URL=http://localhost:5000

# =====================================
# JWT AUTHENTICATION
# =====================================
JWT_SECRET_KEY=YourSuperSecretKeyForJWT_ChangeThisInProduction_MinimumLength32Characters!
JWT_ISSUER=EventEaseApp
JWT_AUDIENCE=EventEaseAppUsers
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# =====================================
# EMAIL CONFIGURATION (SendGrid)
# =====================================
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@eventease.com
SENDGRID_FROM_NAME=EventEase

# For Development: Use MailHog (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=

# =====================================
# PAYMENT GATEWAY (Stripe)
# =====================================
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CURRENCY=usd

# =====================================
# EXTERNAL SERVICES
# =====================================

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=your_app_insights_connection_string_here

# Azure Blob Storage (for images, QR codes, certificates)
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string_here
AZURE_STORAGE_CONTAINER_NAME=eventease-files

# =====================================
# SECURITY SETTINGS
# =====================================

# Password Requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_SPECIAL_CHAR=true
PASSWORD_MAX_FAILED_ATTEMPTS=5
PASSWORD_LOCKOUT_MINUTES=15

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# CORS Settings (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5040,http://localhost:3000,http://localhost:4200

# =====================================
# LOGGING CONFIGURATION
# =====================================
LOGGING_LEVEL=Information
LOGGING_SEQ_URL=http://localhost:5341
LOGGING_SEQ_API_KEY=

# =====================================
# FEATURE FLAGS
# =====================================
FEATURE_EMAIL_ENABLED=true
FEATURE_PAYMENT_ENABLED=true
FEATURE_QR_CODE_ENABLED=true
FEATURE_WAITLIST_ENABLED=true
FEATURE_REVIEWS_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_SOCIAL_SHARING_ENABLED=true
FEATURE_CALENDAR_EXPORT_ENABLED=true
FEATURE_CERTIFICATES_ENABLED=true
FEATURE_DARK_MODE_ENABLED=true
FEATURE_PWA_ENABLED=true

# =====================================
# CACHING
# =====================================
CACHE_EVENTS_EXPIRY_MINUTES=10
CACHE_CATEGORIES_EXPIRY_MINUTES=60
CACHE_USER_SESSION_EXPIRY_MINUTES=30

# =====================================
# BACKGROUND JOBS (Hangfire)
# =====================================
HANGFIRE_DASHBOARD_ENABLED=true
HANGFIRE_DASHBOARD_PATH=/hangfire

# =====================================
# NOTIFICATIONS
# =====================================
NOTIFICATION_REMINDER_DAYS_BEFORE=7,1
NOTIFICATION_REMINDER_HOURS_BEFORE=24,1
NOTIFICATION_BATCH_SIZE=100

# =====================================
# BUSINESS RULES
# =====================================
EVENT_MAX_ATTENDEES_DEFAULT=500
EVENT_REGISTRATION_DEADLINE_HOURS=2
EVENT_CANCELLATION_HOURS=24
TICKET_MAX_PER_REGISTRATION=10
WAITLIST_CLAIM_WINDOW_HOURS=24
REVIEW_MIN_RATING=1
REVIEW_MAX_RATING=5

# =====================================
# DEVELOPMENT SETTINGS
# =====================================
ENABLE_SWAGGER=true
ENABLE_DETAILED_ERRORS=true
ENABLE_SENSITIVE_DATA_LOGGING=false
SEED_DATABASE_ON_STARTUP=true
USE_IN_MEMORY_DATABASE=false

# =====================================
# PRODUCTION OVERRIDES
# =====================================
# Uncomment and set these for production deployment
# ASPNETCORE_ENVIRONMENT=Production
# ASPNETCORE_URLS=https://+:443;http://+:80
# APP_BASE_URL=https://eventease.com
# API_BASE_URL=https://api.eventease.com
# DB_TRUST_SERVER_CERTIFICATE=False
# ENABLE_SWAGGER=false
# ENABLE_DETAILED_ERRORS=false
# SEED_DATABASE_ON_STARTUP=false
